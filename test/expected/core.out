-- The core of pg_muninn: readings with provenance, the seven states, loud coverage, and a search
-- that never mixes readers nor answers from stale text. Every tooth has its control.
\set VERBOSITY terse
CREATE EXTENSION pg_muninn;
-- A sealed reader of 4 dimensions (tests hand-craft the codes the reader would produce).
SELECT muninn.reader_register('r1', repeat('a', 64), 4) AS r1;
 r1 
----
  1
(1 row)

SELECT muninn.reader_register('r2', repeat('b', 64), 4) AS r2;
 r2 
----
  2
(1 row)

CREATE TABLE docs (id int PRIMARY KEY, body text);
INSERT INTO docs VALUES (1, 'apple'), (2, 'banana');
SELECT muninn.watch('docs', 'docs'::regclass, 'id', 'r.body', 'r1') AS watch;
 watch 
-------
     1
(1 row)

-- A row written after the watch exists is noted by the trigger.
INSERT INTO docs VALUES (3, 'cherry');
-- ------------------------------------------------ nothing read yet: pending, and find refuses
SELECT state, n, share FROM muninn.coverage('docs') WHERE n > 0;
  state  | n | share  
---------+---+--------
 pending | 3 | 1.0000
(1 row)

SELECT * FROM muninn.find('docs', 1, ARRAY[90,10,0,0]::smallint[]);
ERROR:  muninn: watch docs covers 0.0% of its rows and declared 95.0%: pending 100.0%
-- ------------------------------------------------ the reader reads what next() hands out
CREATE FUNCTION pg_temp.codes(body text) RETURNS TABLE (c64 bigint, c smallint[]) LANGUAGE sql AS $$
    SELECT CASE body WHEN 'apple' THEN 1 WHEN 'banana' THEN 2 WHEN 'cherry' THEN 4 ELSE 8 END,
           CASE body WHEN 'apple'  THEN ARRAY[100,0,0,0]
                     WHEN 'banana' THEN ARRAY[0,100,0,0]
                     WHEN 'cherry' THEN ARRAY[0,0,100,0]
                     ELSE ARRAY[0,0,0,100] END::smallint[]
$$;
SELECT count(*) AS handed_out FROM muninn.next('docs');
 handed_out 
------------
          3
(1 row)

SELECT count(muninn.record('docs', n.key, 'r1', n.text_hash, c.c64, c.c)) AS recorded
  FROM muninn.next('docs') n, pg_temp.codes(n.body) c;
 recorded 
----------
        3
(1 row)

SELECT count(*) AS left_to_read FROM muninn.next('docs');
 left_to_read 
--------------
            0
(1 row)

SELECT state, n, share FROM muninn.coverage('docs') WHERE n > 0;
 state | n | share  
-------+---+--------
 fresh | 3 | 1.0000
(1 row)

SELECT key, round(score::numeric, 4) AS score, hamming, state
  FROM muninn.find('docs', 1, ARRAY[90,10,0,0]::smallint[]);
 key | score  | hamming | state 
-----+--------+---------+-------
 1   | 0.9939 |       0 | fresh
 2   | 0.1104 |       2 | fresh
 3   | 0.0000 |       2 | fresh
(3 rows)

SELECT key FROM muninn.alike('docs', '2', 1);
 key 
-----
 1
(1 row)

-- ------------------------------------------------ a changed row is stale IN THE SAME TRANSACTION
CREATE TEMP TABLE handed AS SELECT text_hash FROM muninn.sources WHERE key = '1';
BEGIN;
UPDATE docs SET body = 'apricot' WHERE id = 1;
SELECT key, state FROM muninn.reading_states WHERE key = '1';
 key | state 
-----+-------
 1   | stale
(1 row)

COMMIT;
-- control: the untouched rows are still fresh
SELECT key, state FROM muninn.reading_states WHERE key IN ('2', '3') ORDER BY key;
 key | state 
-----+-------
 2   | fresh
 3   | fresh
(2 rows)

-- stale text is never searched, and coverage now refuses...
SELECT state, n, share FROM muninn.coverage('docs') WHERE n > 0;
 state | n | share  
-------+---+--------
 fresh | 2 | 0.6667
 stale | 1 | 0.3333
(2 rows)

SELECT * FROM muninn.find('docs', 1, ARRAY[90,10,0,0]::smallint[]);
ERROR:  muninn: watch docs covers 66.7% of its rows and declared 95.0%: stale 33.3%
-- ...unless the caller accepts a partial answer knowingly, and then the stale row is not in it
SELECT key, state FROM muninn.find('docs', 1, ARRAY[90,10,0,0]::smallint[], p_partial => true) ORDER BY key;
 key | state 
-----+-------
 2   | fresh
 3   | fresh
(2 rows)

-- a reading of the text that was there before is refused
SELECT muninn.record('docs', '1', 'r1', (SELECT text_hash FROM handed), 1, ARRAY[100,0,0,0]::smallint[]);
ERROR:  muninn: row 1 of watch docs changed since it was handed out; this reading would be stale
-- control: a reading of the current text is accepted, and the row is fresh again
SELECT count(muninn.record('docs', n.key, 'r1', n.text_hash, c.c64, c.c)) AS recorded
  FROM muninn.next('docs') n, pg_temp.codes(n.body) c;
 recorded 
----------
        1
(1 row)

SELECT key, state FROM muninn.reading_states WHERE key = '1';
 key | state 
-----+-------
 1   | fresh
(1 row)

-- ------------------------------------------------ readers are never mixed
SELECT muninn.record('docs', '2', 'r2', (SELECT text_hash FROM muninn.sources WHERE key = '2'), 2, ARRAY[0,100,0,0]::smallint[]);
ERROR:  muninn: watch docs is read by reader #1, not by r2
-- a question of the wrong size is refused
SELECT * FROM muninn.find('docs', 1, ARRAY[1,2,3]::smallint[]);
ERROR:  muninn: the question must be read by the watch's reader (4 dimensions)
-- ------------------------------------------------ a deleted row leaves an orphan, not a silent ghost
DELETE FROM docs WHERE id = 3;
SELECT key, state FROM muninn.reading_states WHERE key = '3';
 key | state  
-----+--------
 3   | orphan
(1 row)

SELECT key FROM muninn.find('docs', 4, ARRAY[0,0,100,0]::smallint[]) ORDER BY key;
 key 
-----
 1
 2
(2 rows)

-- ------------------------------------------------ a failed reading says why, and counts
SELECT muninn.record_failure('docs', '2', 'r1', (SELECT text_hash FROM muninn.sources WHERE key = '2'), '');
ERROR:  muninn: a failed reading says why
SELECT muninn.record_failure('docs', '2', 'r1', (SELECT text_hash FROM muninn.sources WHERE key = '2'), 'empty after cleaning');
 record_failure 
----------------
 
(1 row)

SELECT key, state, failed FROM muninn.reading_states WHERE key = '2';
 key | state  |        failed        
-----+--------+----------------------
 2   | failed | empty after cleaning
(1 row)

-- ------------------------------------------------ the trigger's writers cannot be called directly
SELECT muninn._note((SELECT id FROM muninn.watches WHERE name = 'docs'), '1', '\x00');
ERROR:  muninn: _note() is called by a watch trigger, not directly
SELECT muninn._forget((SELECT id FROM muninn.watches WHERE name = 'docs'), '1');
ERROR:  muninn: _forget() is called by a watch trigger, not directly
-- ------------------------------------------------ a new reader makes every old reading foreign
SELECT muninn.reader_switch('docs', 'r2');
 reader_switch 
---------------
 
(1 row)

SELECT state, n, share FROM muninn.coverage('docs') WHERE n > 0;
  state  | n | share  
---------+---+--------
 pending | 2 | 1.0000
 foreign | 3 |       
(2 rows)

SELECT * FROM muninn.find('docs', 1, ARRAY[90,10,0,0]::smallint[]);
ERROR:  muninn: watch docs covers 0.0% of its rows and declared 95.0%: pending 100.0%
-- ------------------------------------------------ the manifest contract (a trained reader)
\set m '{"reader":"vec","version":"0.1.0","base_sha256":"cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc","adapter_sha256":"dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd","heads_sha256":"eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee","marker":"<v>","pooling":"none","read_at":"last_marker_token","mrl_dims":[4096,1024,256,64],"query_instruction":"Query: "}'
-- the base must be sealed by whoever serves it
SELECT muninn.reader_register(jsonb_set(:'m'::jsonb, '{base_sha256}', 'null'));
ERROR:  muninn: base_sha256 is not sealed
-- not the marker contract
SELECT muninn.reader_register(jsonb_set(:'m'::jsonb, '{pooling}', '"last"'));
ERROR:  muninn: this manifest is not of the marker contract (marker, pooling none, read_at last_marker_token)
-- no 64-dim prefix: there would be no binary code
SELECT muninn.reader_register(jsonb_set(:'m'::jsonb, '{mrl_dims}', '[4096,1024]'));
ERROR:  muninn: mrl_dims must include 64 (the binary code) and at least one prefix to keep
-- a heads sha that is not a sha
SELECT muninn.reader_register(jsonb_set(:'m'::jsonb, '{heads_sha256}', '"x"'));
ERROR:  muninn: heads_sha256 must be a sha256
-- control: the same manifest, sealed, registers; it keeps the 1024 prefix and its heads
SELECT muninn.reader_register(:'m'::jsonb) > 0 AS registered;
 registered 
------------
 t
(1 row)

SELECT name, dims, left(heads_sha, 4) AS heads, manifest->>'marker' AS marker FROM muninn.readers WHERE name = 'vec-0.1.0';
   name    | dims | heads | marker 
-----------+------+-------+--------
 vec-0.1.0 | 1024 | eeee  | <v>
(1 row)

SELECT left(model_sha, 4) AS model, left(adapter_sha, 4) AS adapter, dims, left(heads_sha, 4) AS heads,
       manifest->>'query_instruction' AS instruction
  FROM muninn.reader_seal('vec-0.1.0');
 model | adapter | dims | heads | instruction 
-------+---------+------+-------+-------------
 cccc  | dddd    | 1024 | eeee  | Query: 
(1 row)

-- the same weights cannot be registered twice under another version
SELECT muninn.reader_register(jsonb_set(:'m'::jsonb, '{version}', '"0.1.1"'));
ERROR:  duplicate key value violates unique constraint "readers_seal_key"
-- different heads are a different reader
SELECT muninn.reader_register(jsonb_set(jsonb_set(:'m'::jsonb, '{version}', '"0.1.1"'), '{heads_sha256}', to_jsonb(repeat('f', 64)))) > 0 AS other_heads;
 other_heads 
-------------
 t
(1 row)

-- ------------------------------------------------ only the table's owner may watch it
CREATE ROLE regress_muninn_stranger;
GRANT USAGE ON SCHEMA muninn TO regress_muninn_stranger;
GRANT EXECUTE ON FUNCTION muninn.watch(text, regclass, name, text, text, numeric, real) TO regress_muninn_stranger;
SET ROLE regress_muninn_stranger;
SELECT muninn.watch('stolen', 'docs'::regclass, 'id', 'r.body', 'r1');
ERROR:  muninn: a watch is a trigger on public.docs, so only its owner may create one
-- and a stranger reads nothing
SELECT count(*) FROM muninn.readings;
ERROR:  permission denied for table readings
RESET ROLE;
-- an unknown reader, a missing column, a recipe that is not an expression over the row
SELECT muninn.watch('w2', 'docs'::regclass, 'id', 'r.body', 'nobody');
ERROR:  muninn: no reader named nobody
SELECT muninn.watch('w2', 'docs'::regclass, 'nope', 'r.body', 'r1');
ERROR:  muninn: public.docs has no column nope
SELECT muninn.watch('w2', 'docs'::regclass, 'id', 'r.missing_column', 'r1');
ERROR:  column r.missing_column does not exist at character 9
DROP OWNED BY regress_muninn_stranger;
DROP ROLE regress_muninn_stranger;
-- ------------------------------------------------ a reading the reader did not recognize is doubtful
-- The seventh state: the text is current and the reading is the reader's, but its familiarity is
-- under the watch's doubt_below. It still counts as covered and is still found, marked as such.
CREATE TABLE notes (id int PRIMARY KEY, body text);
INSERT INTO notes VALUES (1, 'known'), (2, 'invented');
SELECT muninn.watch('notes', 'notes'::regclass, 'id', 'r.body', 'r1', 0.95, 0.5) > 0 AS watch;
 watch 
-------
 t
(1 row)

SELECT count(muninn.record('notes', n.key, 'r1', n.text_hash,
                           CASE n.key WHEN '1' THEN 1 ELSE 2 END,
                           CASE n.key WHEN '1' THEN ARRAY[100,0,0,0] ELSE ARRAY[90,10,0,0] END::smallint[],
                           CASE n.key WHEN '1' THEN 0.9 ELSE 0.2 END::real)) AS recorded
  FROM muninn.next('notes') n;
 recorded 
----------
        2
(1 row)

-- control: the familiar reading is fresh; the other one, under 0.5, is doubtful
SELECT key, state FROM muninn.reading_states WHERE watch = 'notes' ORDER BY key;
 key |  state   
-----+----------
 1   | fresh
 2   | doubtful
(2 rows)

SELECT state, n, share FROM muninn.coverage('notes') WHERE n > 0;
  state   | n | share  
----------+---+--------
 fresh    | 1 | 0.5000
 doubtful | 1 | 0.5000
(2 rows)

SELECT key, state FROM muninn.find('notes', 2, ARRAY[90,10,0,0]::smallint[]) ORDER BY key;
 key |  state   
-----+----------
 1   | fresh
 2   | doubtful
(2 rows)

DROP TABLE notes;
-- ------------------------------------------------ the counts never lie (0.2.0)
-- coverage() reads counts the triggers keep; coverage_check() recounts the tables from scratch.
-- After every kind of change above -- readings, stale text, an orphan, a failure, a new reader --
-- they agree.
SELECT count(*) AS mismatches FROM muninn.coverage_check('docs');
 mismatches 
------------
          0
(1 row)

-- control: a count corrupted by hand is reported...
UPDATE muninn.counts SET n = n + 1 WHERE watch = (SELECT id FROM muninn.watches WHERE name = 'docs') AND state = 'foreign';
SELECT state, counted, recounted FROM muninn.coverage_check('docs');
  state  | counted | recounted 
---------+---------+-----------
 foreign |       4 |         3
(1 row)

-- ...a recount repairs it...
SELECT muninn._recount((SELECT id FROM muninn.watches WHERE name = 'docs'));
 _recount 
----------
 
(1 row)

SELECT count(*) AS mismatches FROM muninn.coverage_check('docs');
 mismatches 
------------
          0
(1 row)

-- ...and a count can never go below zero
UPDATE muninn.counts SET n = -1 WHERE watch = (SELECT id FROM muninn.watches WHERE name = 'docs') AND state = 'orphan';
ERROR:  new row for relation "counts" violates check constraint "a_count_is_never_negative"
-- ------------------------------------------------ the 256-bit sweep (0.2.0)
-- Three rows of a 256-dimension reader. Row 'a' is the nearest by its 256-bit code but the farthest
-- by its 64-bit code; with m = 1 only the candidate the sweep picks is reranked, so the answer says
-- which code was swept.
SELECT muninn.reader_register('r256', repeat('9', 64), 256) > 0 AS r256;
 r256 
------
 t
(1 row)

CREATE TABLE wide (id text PRIMARY KEY, body text);
INSERT INTO wide VALUES ('a', 'alpha'), ('b', 'beta'), ('c', 'gamma');
SELECT muninn.watch('wide', 'wide'::regclass, 'id', 'r.body', 'r256') > 0 AS watch;
 watch 
-------
 t
(1 row)

SELECT count(muninn.record('wide', n.key, 'r256', n.text_hash,
                           CASE n.key WHEN 'a' THEN -1 ELSE 0 END,          -- 64 bits: 'a' is far
                           array_fill(CASE n.key WHEN 'a' THEN 100 WHEN 'b' THEN 50 ELSE -100 END::smallint, ARRAY[256]),
                           NULL,
                           CASE n.key WHEN 'a' THEN repeat('1', 256) WHEN 'b' THEN repeat('1', 128) || repeat('0', 128)
                                      ELSE repeat('0', 256) END::bit(256)))  -- 256 bits: 'a' is near
                           AS recorded
  FROM muninn.next('wide') n;
 recorded 
----------
        3
(1 row)

-- the question: all ones in 256 bits, all zeros in 64
SELECT key, hamming FROM muninn.find('wide', 0, array_fill(100::smallint, ARRAY[256]), 1, false, 1,
                                     repeat('1', 256)::bit(256));
 key | hamming 
-----+---------
 a   |       0
(1 row)

-- control: the same question without its 256-bit code sweeps the 64-bit one and gets another row
SELECT key, hamming FROM muninn.find('wide', 0, array_fill(100::smallint, ARRAY[256]), 1, false, 1);
 key | hamming 
-----+---------
 b   |       0
(1 row)

-- a 256-bit code from a reader of fewer dimensions is refused
SELECT muninn.record('docs', '2', 'r2', (SELECT text_hash FROM muninn.sources WHERE key = '2' AND watch = (SELECT id FROM muninn.watches WHERE name = 'docs')),
                     2, ARRAY[0,100,0,0]::smallint[], NULL, repeat('1', 256)::bit(256));
ERROR:  muninn: reader r2 has 4 dimensions; a 256-bit code needs at least 256
SELECT count(*) AS mismatches FROM muninn.coverage_check('wide');
 mismatches 
------------
          0
(1 row)

DROP TABLE wide;
-- ------------------------------------------------ the reader on its own: queue, audits, dupes (0.3.0)
CREATE TABLE q3 (id int PRIMARY KEY, body text);
INSERT INTO q3 VALUES (1, 'one'), (2, 'two'), (3, 'three'), (4, 'four');
SELECT muninn.watch('q3', 'q3'::regclass, 'id', 'r.body', 'r1') > 0 AS watch;
 watch 
-------
 t
(1 row)

SELECT count(muninn.record('q3', n.key, 'r1', n.text_hash, n.key::bigint,
                           CASE WHEN n.key IN ('1', '2') THEN ARRAY[100,0,0,0] ELSE ARRAY[0,0,n.key::int * 10,100] END::smallint[]))
  FROM muninn.next('q3') n WHERE n.key <> '4';
 count 
-------
     3
(1 row)

SELECT muninn.record_failure('q3', '4', 'r1', (SELECT text_hash FROM muninn.sources WHERE key = '4' AND watch = (SELECT id FROM muninn.watches WHERE name = 'q3')), 'no tokens');
 record_failure 
----------------
 
(1 row)

-- a failed reading of the current text is not handed out again...
SELECT count(*) AS to_read FROM muninn.next('q3');
 to_read 
---------
       0
(1 row)

-- ...but once its text changes it is, exactly as in 0.1.0
UPDATE q3 SET body = 'four, now readable' WHERE id = 4;
SELECT key FROM muninn.next('q3');
 key 
-----
 4
(1 row)

-- a re-reading that reproduces the reading holds
SELECT muninn.record_audit('q3', '1', 'r1', (SELECT text_hash FROM muninn.readings WHERE key = '1' AND watch = (SELECT id FROM muninn.watches WHERE name = 'q3')),
                           ARRAY[100,0,0,0]::smallint[], NULL) AS holds;
 holds 
-------
 t
(1 row)

-- control: a re-reading that does not is recorded as a broken assertion
SELECT muninn.record_audit('q3', '2', 'r1', (SELECT text_hash FROM muninn.readings WHERE key = '2' AND watch = (SELECT id FROM muninn.watches WHERE name = 'q3')),
                           ARRAY[0,100,0,0]::smallint[], NULL) AS holds;
 holds 
-------
 f
(1 row)

SELECT key, same_code256, round(cosine::numeric, 3) AS cosine, holds FROM muninn.audits ORDER BY id;
 key | same_code256 | cosine | holds 
-----+--------------+--------+-------
 1   | t            |  1.000 | t
 2   | t            |  0.000 | f
(2 rows)

-- a row that changed is not audited: there is no reading of its current text
UPDATE q3 SET body = 'one, edited' WHERE id = 1;
SELECT muninn.record_audit('q3', '1', 'r1', (SELECT text_hash FROM muninn.sources WHERE key = '1' AND watch = (SELECT id FROM muninn.watches WHERE name = 'q3')),
                           ARRAY[100,0,0,0]::smallint[], NULL) AS holds;
 holds 
-------
 
(1 row)

SELECT key FROM muninn.audit_sample('q3', 10) ORDER BY key;
 key 
-----
 2
 3
(2 rows)

-- dupes counts only fresh readings: 1 back to the text it was read from is fresh again; 1 and 2
-- share a code, 3 is not alike
UPDATE q3 SET body = 'one' WHERE id = 1;
SELECT key_a, key_b, round(cosine::numeric, 3) AS cosine FROM muninn.dupes('q3', 0.98);
 key_a | key_b | cosine 
-------+-------+--------
 1     | 2     |  1.000
(1 row)

-- control: with a lower threshold the dissimilar pair appears too
SELECT count(*) AS pairs FROM muninn.dupes('q3', -1);
 pairs 
-------
     3
(1 row)

SELECT count(*) AS mismatches FROM muninn.coverage_check('q3');
 mismatches 
------------
          0
(1 row)

DROP TABLE q3;
-- ------------------------------------------------ dropping the table drops its watch
SELECT count(*) AS watches_before FROM muninn.watches;
 watches_before 
----------------
              1
(1 row)

DROP TABLE docs;
SELECT count(*) AS watches_after FROM muninn.watches;
 watches_after 
---------------
             0
(1 row)

DROP EXTENSION pg_muninn;
