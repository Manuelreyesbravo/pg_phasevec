-- in a transaction that made one and dropped it: refused, it has written (ninth review)
BEGIN;
CREATE TEMP TABLE pv_tl_scratch (x int);
SELECT count(*) FROM phasevec.verify($w$notes$w$, p_every => interval '0');
ERROR:  phasevec: proofs judge what is committed, and this transaction has written
ROLLBACK;
-- emptied, the same
DISCARD TEMP;
SELECT key, verdict FROM phasevec.verify($w$notes$w$, p_every => interval '0') ORDER BY key::int;
 key | verdict  
-----+----------
