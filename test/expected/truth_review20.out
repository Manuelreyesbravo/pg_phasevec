DROP TABLE u20;
DROP EXTENSION pg_phasevec;
DROP FUNCTION public.pv20_noop();
REVOKE SET ON PARAMETER lo_compat_privileges FROM pv20_grp;
DROP SCHEMA app20, lib20 CASCADE;
NOTICE:  drop cascades to 3 other objects
DROP OWNED BY pv20_au, pv20_other, pv20_grp;
DROP ROLE pv20_au, pv20_other, pv20_grp;
