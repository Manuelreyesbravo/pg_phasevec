SELECT (SELECT array_agg(key ORDER BY score DESC, key) FROM phasevec.find('docs', 0, code_of(130), 10, false, 2100, signs_of(code_of(130))))
     = (SELECT array_agg(key ORDER BY score DESC, key) FROM phasevec.find_ivf('docs', 0, code_of(130), 10, false, 2100, signs_of(code_of(130)), 1000))
       AS same_as_find;
 same_as_find 
--------------
 t
(1 row)

-- a row absorbed, then its text changes: not served (the validation drops its list entry)
BEGIN;
UPDATE docs SET body = 'changed' WHERE id = 120;
SELECT count(*) AS served_stale FROM phasevec.find_ivf('docs', 0, code_of(121), 10, false, 2000, signs_of(code_of(121)), 1000) WHERE key = '120';
 served_stale 
--------------
            0
(1 row)

ROLLBACK;
-- what was absorbed lives in chunks, never in the rewritten lists; a backend that loads the index itself
-- (no shared copy) joins lists and chunks and still answers exactly what find answers
SELECT count(*) > 0 AS chunks, sum(n) AS chunk_readings FROM phasevec.ivf_added;
 chunks | chunk_readings 
--------+----------------
 t      |             40
(1 row)

SET phasevec.shared_ivf_cache = off;
SELECT (SELECT array_agg(key ORDER BY score DESC, key) FROM phasevec.find('docs', 0, code_of(130), 10, false, 2100, signs_of(code_of(130))))
     = (SELECT array_agg(key ORDER BY score DESC, key) FROM phasevec.find_ivf('docs', 0, code_of(130), 10, false, 2100, signs_of(code_of(130)), 1000))
       AS same_as_find_loaded;
 same_as_find_loaded 
---------------------
 t
(1 row)

