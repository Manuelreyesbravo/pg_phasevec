-- a delta row of a transaction no snapshot can see yet (here, a future xid): never emptied
INSERT INTO phasevec.ivf_dirty (watch, key, txid)
    SELECT w.id, '2000', (pg_current_xact_id()::text::bigint + 1000000)::text::xid8 FROM phasevec.watches w WHERE w.name = 'docs';
-- 60 more: 111 >= 100, rebuilt
SELECT read_as('r256', 51, 110, 1) AS reread;
