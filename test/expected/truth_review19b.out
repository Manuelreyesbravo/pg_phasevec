 4   | {"search_path=pg_catalog, lib19b, pg_temp"} | pv19b_au
 5   | {"search_path=pg_catalog, lib19b, pg_temp"} | pv19b_au
(3 rows)

SELECT count(DISTINCT proof_env) AS envs FROM phasevec.truth WHERE key IN ($k$3$k$, $k$4$k$, $k$5$k$);
