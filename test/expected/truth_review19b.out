SET ROLE pv19b_wr;
TRUNCATE n19b;
RESET ROLE;
SELECT count(*) FILTER (WHERE phasevec._verdict(t) = $v$verified$v$) AS verified FROM phasevec.truth t;
 verified 
----------
        0
(1 row)

SELECT * FROM phasevec.truth_coverage($w$n19b$w$) ORDER BY 1;
 verdict | n 
---------+---
(0 rows)

