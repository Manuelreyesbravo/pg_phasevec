SELECT key, verdict FROM phasevec.verify($w$n19b$w$, 10, $e$0$e$) WHERE key IN ($k$3$k$, $k$4$k$, $k$5$k$) ORDER BY key;
 key | verdict  
-----+----------
 3   | verified
