SELECT key, array(SELECT e FROM unnest(proof_env) e WHERE e ~ '^search_path') AS env,
       asserted_by FROM phasevec.truth WHERE key IN ($k$3$k$, $k$4$k$, $k$5$k$) ORDER BY key;
